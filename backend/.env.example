PORT=3000
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/eventhub
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/eventhub_test

# Tokens JWT
JWT_ACCESS_SECRET=cambia-este-secreto-de-access-token
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# URLs permitidas para CORS (separadas por coma) y frontend
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Correos con Resend
RESEND_API_KEY=
EMAIL_FROM=EventHub <onboarding@resend.dev>

# Almacenamiento externo (Cloudflare R2 o AWS S3)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Servicio serverless de reportes (segunda mitad)
REPORTS_SERVICE_URL=
REPORTS_API_KEY=
